[Unit]
Description=SentrAI collector (tails approved logs, sends events to the core)
PartOf=cactai.target
After=cactai-core.service
Wants=cactai-core.service

[Service]
Type=simple
WorkingDirectory=@PREFIX@/mvp/lab
ExecStart=@PREFIX@/mvp/lab/.venv/bin/python -m collector.collector
User=@USER@
Group=@USER@
EnvironmentFile=/etc/cactai/cactai.env
Environment=HOME=/var/lib/cactai PYTHONUNBUFFERED=1 PYTHONUTF8=1 PYTHONIOENCODING=utf-8
Restart=on-failure
RestartSec=5
# Reads logs and /proc, writes only its own state folder.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/cactai

[Install]
WantedBy=cactai.target
