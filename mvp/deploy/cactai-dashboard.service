[Unit]
Description=SentrAI dashboard (Streamlit)
PartOf=cactai.target
After=cactai-core.service
Wants=cactai-core.service

[Service]
Type=simple
WorkingDirectory=@PREFIX@/mvp/dashboard
# "+" runs it as root: when the dashboard is opened to CACTAI_DASHBOARD_ALLOW, only those addresses get through.
ExecStartPre=+/bin/sh -c 'if grep -q "^CACTAI_DASHBOARD_ALLOW=." /etc/cactai/cactai.env; then exec /usr/local/sbin/cactai-dashboard-firewall; fi'
ExecStart=@PREFIX@/mvp/dashboard/.venv/bin/python -m streamlit run app.py --server.address ${CACTAI_DASHBOARD_HOST} --server.port ${CACTAI_DASHBOARD_PORT} --server.headless true --browser.gatherUsageStats false
User=@USER@
Group=@USER@
EnvironmentFile=/etc/cactai/cactai.env
Environment=HOME=/var/lib/cactai PYTHONUNBUFFERED=1 PYTHONUTF8=1 PYTHONIOENCODING=utf-8
Restart=on-failure
RestartSec=5
# Reads logs and /proc, writes only its own state folder.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/cactai

[Install]
WantedBy=cactai.target
