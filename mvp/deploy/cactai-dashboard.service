[Unit]
Description=SentrAI dashboard (Streamlit)
PartOf=cactai.target
After=cactai-core.service
Wants=cactai-core.service

[Service]
Type=simple
WorkingDirectory=@PREFIX@/mvp/dashboard
# "+" runs it as root: when the dashboard is opened to CACTAI_DASHBOARD_ALLOW, only those addresses get through.
ExecStartPre=+/bin/sh -c 'if grep -q "^CACTAI_DASHBOARD_ALLOW=." /etc/cactai/cactai.env; then exec /usr/local/sbin/cactai-dashboard-firewall; fi'
ExecStart=@PREFIX@/mvp/dashboard/.venv/bin/python -m streamlit run app.py --server.address ${CACTAI_DASHBOARD_HOST} --server.port ${CACTAI_DASHBOARD_PORT} --server.headless true --browser.gatherUsageStats false
User=@USER@
Group=@USER@
EnvironmentFile=/etc/cactai/cactai.env
Environment=HOME=/var/lib/cactai PYTHONUNBUFFERED=1 PYTHONUTF8=1 PYTHONIOENCODING=utf-8
Restart=on-failure
RestartSec=5
# Least privilege: no log access and no capabilities. It writes the settings file and talks to
# the core over its API; the audit record and the collector's positions are hidden from it.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectProc=invisible
ReadWritePaths=/var/lib/cactai
ReadOnlyPaths=/var/lib/cactai/scout
InaccessiblePaths=-/var/lib/cactai/core -/var/lib/cactai/collector

[Install]
WantedBy=cactai.target
