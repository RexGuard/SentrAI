[Unit]
Description=SentrAI (core, collector, dashboards, notifier)
Documentation=https://github.com/RexGuard/sentrai/blob/main/mvp/deploy/README.md
Wants=sentrai-core.service sentrai-collector.service sentrai-dashboard.service sentrai-web.service sentrai-notifier.service

[Install]
WantedBy=multi-user.target
