[Unit]
Description=SentrAI classic dashboard (Streamlit)
PartOf=sentrai.target
After=sentrai-core.service
Wants=sentrai-core.service

[Service]
Type=simple
WorkingDirectory=@PREFIX@/mvp/dashboard
# "+" runs it as root: when the dashboard is opened to SENTRAI_DASHBOARD_ALLOW, only those addresses get through.
ExecStartPre=+/bin/sh -c 'if grep -q "^SENTRAI_DASHBOARD_ALLOW=." /etc/sentrai/sentrai.env; then exec /usr/local/sbin/sentrai-dashboard-firewall; fi'
ExecStart=@PREFIX@/mvp/dashboard/.venv/bin/python -m streamlit run app.py --server.address ${SENTRAI_CLASSIC_HOST} --server.port ${SENTRAI_CLASSIC_PORT} --server.headless true --browser.gatherUsageStats false
User=@USER@
Group=@USER@
EnvironmentFile=/etc/sentrai/sentrai.env
Environment=HOME=/var/lib/sentrai PYTHONUNBUFFERED=1 PYTHONUTF8=1 PYTHONIOENCODING=utf-8
Restart=on-failure
RestartSec=5
# Least privilege: no log access and no capabilities. It writes the settings file and talks to
# the core over its API; the audit record and the collector's positions are hidden from it.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectProc=invisible
ReadWritePaths=/var/lib/sentrai
ReadOnlyPaths=/var/lib/sentrai/scout
InaccessiblePaths=-/var/lib/sentrai/core -/var/lib/sentrai/collector

[Install]
WantedBy=sentrai.target
