<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. A panel with its own (self-signed) certificate is trusted only after the person checks its
     fingerprint in the app, which then pins it (PanelClient.kt). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
